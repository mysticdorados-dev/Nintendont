+/* Start report 0x0A on the vendor/bulk USB interface. The command
+   sequence is the same one demonstrated in the vWii probe Build #4.
+   This is an experimental path: synchronous USB reads have no explicit
+   timeout at this layer; test ONLY with the intended device attached. */
+static s32 NSOGCInitVendor(s32 device_id)
+{
+    s32 ret;
+    unsigned int i;
+    s32 io_buffer[8] ALIGNED(32);
+
+    memset32(io_buffer,0,32);
+    io_buffer[0] = device_id;
+    io_buffer[2] = 1; /* resume */
+    ret = IOS_Ioctl(nsogc_vendor_host, ResumeDevice, io_buffer,32,NULL,0);
+    if (ret < 0) return ret;
+
+    for(i=0; i<NSOGC_INIT_COUNT; ++i)
+    {
+        memset32(nsogc_vendor_tx,0,64);
+        memcpy(nsogc_vendor_tx, nsogc_init_sequence[i].bytes,
+               nsogc_init_sequence[i].length);
+        sync_after_write(nsogc_vendor_tx,64);
+        ret = USB_WriteBlkMsg(device_id, NSOGC_USB_VENDOR_OUT,
+                    nsogc_init_sequence[i].length, nsogc_vendor_tx);
+        if(ret < 0) return ret;
+        memset32(nsogc_vendor_rx,0,64);
+        sync_after_write(nsogc_vendor_rx,64);
+        ret = USB_ReadBlkMsg(device_id, NSOGC_USB_VENDOR_IN,64,nsogc_vendor_rx);
+        if(ret < 0) return ret;
+        sync_before_read(nsogc_vendor_rx,64);
+    }
+    return 0;
+}
+
+static void NSOGCVirtualize(const u8 *src, u32 length)
+{
+    nsogc_pad_state state;
+    if(nsogc_parse_gc_report(src,length,&state) != 0) return;
+    memset32(nsogc_virtual_pad,0,32);
+    if(state.a) nsogc_virtual_pad[0]|=0x01;
+    if(state.b) nsogc_virtual_pad[0]|=0x02;
+    if(state.x) nsogc_virtual_pad[0]|=0x04;
+    if(state.y) nsogc_virtual_pad[0]|=0x08;
+    if(state.z) nsogc_virtual_pad[0]|=0x10;
+    if(state.start) nsogc_virtual_pad[0]|=0x20;
+    /* NSO GameCube triggers have analogue travel; digital click threshold
+       is provisional until hardware-calibrated by game testing. */
+    if(state.lt >= 180 || state.left_shoulder) nsogc_virtual_pad[0]|=0x40;
+    if(state.rt >= 180) nsogc_virtual_pad[0]|=0x80;
+    if(state.up) nsogc_virtual_pad[1]|=0x01;
+    if(state.down) nsogc_virtual_pad[1]|=0x02;
+    if(state.left) nsogc_virtual_pad[1]|=0x04;
+    if(state.right) nsogc_virtual_pad[1]|=0x08;
+    nsogc_virtual_pad[2]=nsogc_axis_to_gc_u8(state.lx);
+    nsogc_virtual_pad[3]=(u8)(255u - nsogc_axis_to_gc_u8(state.ly));
+    nsogc_virtual_pad[4]=nsogc_axis_to_gc_u8(state.rx);
+    nsogc_virtual_pad[5]=nsogc_axis_to_gc_u8(state.ry);
+    nsogc_virtual_pad[6]=(state.lt < 32) ? 0 : state.lt;
+    nsogc_virtual_pad[7]=(state.rt < 32) ? 0 : state.rt;
+    memcpy(HID_Packet,nsogc_virtual_pad,32);
+    sync_after_write(HID_Packet,32);
+}
